<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>CertNET.Plugins.Cloudflare</RootNamespace>

        <!-- NuGet Package Metadata -->
        <PackageId>CertNET.Plugins.Cloudflare</PackageId>
        <Version>1.0.0</Version>
        <Description>Cloudflare DNS plugin for CertNET. Enables obtaining wildcard and DNS-validated certificates using the Cloudflare API.</Description>
        <PackageTags>certbot;letsencrypt;ssl;tls;certificate;acme;cloudflare;dns</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Authors>CertNET</Authors>
        <PackageProjectUrl>https://github.com/Alexr03/CertNET</PackageProjectUrl>
        <RepositoryUrl>https://github.com/Alexr03/CertNET</RepositoryUrl>
        <PackageIcon>CertNET.png</PackageIcon>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\CertNET\CertNET.csproj" />
    </ItemGroup>

    <ItemGroup>
      <None Update="CertNET.png">
        <Pack>True</Pack>
        <PackagePath></PackagePath>
      </None>
    </ItemGroup>

</Project>
